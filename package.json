{
  "name": "chat-desktop",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run typecheck && npm run build:main && vite build",
    "start": "npm run build && electron .",
    "dev": "concurrently -k \"tsc -p tsconfig.main.json --watch\" \"tsc -p tsconfig.renderer.json --watch\" \"vite\" \"wait-on http://localhost:5173 && nodemon --watch dist/main --watch dist/preload --exec electron .\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "socket.io-client": "^4.8.3"
  }
}
